{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "agent-workflow-training :: USER SCOPE. Installed to ~/.claude/settings.json. Applies to ALL Claude Code sessions on this machine. Project-scoped settings can extend but should not weaken these.",

  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "NotebookEdit(**/.env)",

      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat **/.env*)",
      "Bash(less .env*)",
      "Bash(less ./.env*)",
      "Bash(less **/.env*)",
      "Bash(more .env*)",
      "Bash(more ./.env*)",
      "Bash(more **/.env*)",
      "Bash(head .env*)",
      "Bash(head ./.env*)",
      "Bash(head **/.env*)",
      "Bash(tail .env*)",
      "Bash(tail ./.env*)",
      "Bash(tail **/.env*)",
      "Bash(bat .env*)",
      "Bash(bat ./.env*)",
      "Bash(bat **/.env*)",
      "Bash(nl .env*)",
      "Bash(nl **/.env*)",
      "Bash(xxd .env*)",
      "Bash(xxd **/.env*)",
      "Bash(od .env*)",
      "Bash(od **/.env*)",
      "Bash(strings .env*)",
      "Bash(strings **/.env*)",
      "Bash(hexdump .env*)",
      "Bash(hexdump **/.env*)",
      "Bash(. .env*)",
      "Bash(. ./.env*)",
      "Bash(. **/.env*)",
      "Bash(source .env*)",
      "Bash(source ./.env*)",
      "Bash(source **/.env*)",
      "Bash(cp .env* **)",
      "Bash(cp ./.env* **)",
      "Bash(cp **/.env* **)",
      "Bash(mv .env* **)",
      "Bash(mv ./.env* **)",
      "Bash(mv **/.env* **)",
      "Bash(cat *.pem)",
      "Bash(cat **/*.pem)",
      "Bash(cat *.key)",
      "Bash(cat **/*.key)",
      "Bash(cat **/id_rsa)",
      "Bash(cat **/id_ed25519)",

      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(echo $*)",
      "Bash(echo ${*})",
      "Bash(echo \"$*\")",
      "Bash(echo \"${*}\")",
      "Bash(set)",
      "Bash(declare -p*)",
      "Bash(export)",
      "Bash(export -p)",

      "PowerShell(Get-Content .env*)",
      "PowerShell(Get-Content ./.env*)",
      "PowerShell(Get-Content **/.env*)",
      "PowerShell(gc .env*)",
      "PowerShell(gc **/.env*)",
      "PowerShell(type .env*)",
      "PowerShell(type **/.env*)",
      "PowerShell(cat .env*)",
      "PowerShell(cat **/.env*)",
      "PowerShell(Set-Content .env*)",
      "PowerShell(Set-Content **/.env*)",
      "PowerShell(Out-File .env*)",
      "PowerShell(Out-File **/.env*)",
      "PowerShell(Add-Content .env*)",
      "PowerShell(Add-Content **/.env*)",
      "PowerShell(Copy-Item .env* **)",
      "PowerShell(Copy-Item **/.env* **)",
      "PowerShell(Move-Item .env* **)",
      "PowerShell(Move-Item **/.env* **)",
      "PowerShell(Get-Content *.pem)",
      "PowerShell(Get-Content **/*.pem)",
      "PowerShell(Get-Content *.key)",
      "PowerShell(Get-Content **/*.key)",

      "PowerShell(Get-ChildItem env:*)",
      "PowerShell(gci env:*)",
      "PowerShell(ls env:*)",
      "PowerShell(dir env:*)",
      "PowerShell(Get-ChildItem -Path env:*)",
      "PowerShell(Get-ChildItem -Path Env:*)",
      "PowerShell(echo $env:*)",
      "PowerShell(Write-Host $env:*)",
      "PowerShell(Write-Output $env:*)",
      "PowerShell([System.Environment]::GetEnvironmentVariables*)",

      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm*)",
      "Bash(git push --force origin main*)",
      "Bash(git push --force origin master*)",
      "Bash(git push -f origin main*)",
      "Bash(git push -f origin master*)",
      "Bash(git reset --hard origin/main*)",
      "Bash(git reset --hard origin/master*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D master*)",
      "Bash(git clean -fdx*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(gh repo delete*)",
      "Bash(gh auth logout*)",
      "PowerShell(Remove-Item -Recurse -Force /*)",
      "PowerShell(Remove-Item -Recurse -Force ~*)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{USER_HOOKS}}/orient-session.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{USER_HOOKS}}/deny-env-access.js\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{USER_HOOKS}}/guard-security-configs.js\""
          }
        ]
      }
    ]
  }
}
