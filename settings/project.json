{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "agent-workflow-training :: PROJECT SCOPE. Installed to <project>/.claude/settings.json. Commit this file so every team member's checkout enforces the same rules. Extends user-scope settings; cannot weaken them.",

  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "NotebookEdit(**/.env)",

      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat **/.env*)",
      "Bash(less .env*)",
      "Bash(less **/.env*)",
      "Bash(more .env*)",
      "Bash(more **/.env*)",
      "Bash(head .env*)",
      "Bash(head **/.env*)",
      "Bash(tail .env*)",
      "Bash(tail **/.env*)",
      "Bash(bat .env*)",
      "Bash(bat **/.env*)",
      "Bash(nl .env*)",
      "Bash(xxd .env*)",
      "Bash(od .env*)",
      "Bash(strings .env*)",
      "Bash(hexdump .env*)",
      "Bash(. .env*)",
      "Bash(. ./.env*)",
      "Bash(source .env*)",
      "Bash(source ./.env*)",
      "Bash(source **/.env*)",
      "Bash(cp .env* **)",
      "Bash(cp **/.env* **)",
      "Bash(mv .env* **)",
      "Bash(mv **/.env* **)",

      "PowerShell(Get-Content .env*)",
      "PowerShell(Get-Content **/.env*)",
      "PowerShell(gc .env*)",
      "PowerShell(type .env*)",
      "PowerShell(cat .env*)",
      "PowerShell(Set-Content .env*)",
      "PowerShell(Out-File .env*)",
      "PowerShell(Add-Content .env*)",
      "PowerShell(Copy-Item .env* **)",
      "PowerShell(Move-Item .env* **)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/deny-supabase-writes.js\""
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/deny-env-access.js\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-security-configs.js\""
          }
        ]
      }
    ]
  }
}
